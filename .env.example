# ---- Core ----
ENV=development
DATABASE_URL=sqlite:///./salesagent.db
ADMIN_API_KEY=                      # required for all admin endpoints (fail-closed if empty)

# ---- LLM (Groq) ----
LLM_PROVIDER=groq                   # groq | mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
GROQ_INPUT_COST_PER_MTOK=0          # optional, for cost logging (USD per 1M tokens)
GROQ_OUTPUT_COST_PER_MTOK=0

# ---- Pricing policy (USD; enforced deterministically) ----
DEFAULT_MIN_PRICE=1000
DEFAULT_TARGET_PRICE=3000
DEFAULT_MAX_PRICE=25000
DEFAULT_MAX_DISCOUNT_PERCENT=15
PRICING_HOURLY_RATE=100

# ---- Outreach / compliance ----
OUTREACH_DRY_RUN=true               # true = record messages, never send
AUTO_OUTREACH=false                 # pipeline sends outreach automatically after SOLUTION_READY
SENDER_NAME=
SENDER_COMPANY=
SENDER_EMAIL=
SENDER_POSTAL_ADDRESS=              # required by CAN-SPAM for commercial email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Retell (phone) ----
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
RETELL_DRY_RUN=true
CALL_DISCLOSURE_MODE=always         # always | if_asked  (a direct question is ALWAYS answered truthfully)
CALL_REQUIRE_CONSENT=true           # outbound calls only to contacts flagged call_consent
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=17
DEFAULT_TIMEZONE=America/New_York

# ---- TTS (Chatterbox) ----
TTS_PROVIDER=chatterbox             # chatterbox | null
CHATTERBOX_MODE=local               # local | http
CHATTERBOX_URL=                     # for http mode (OpenAI-compatible /v1/audio/speech)
CHATTERBOX_DEVICE=cuda
CHATTERBOX_VOICE_PROMPT_PATH=
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5
TTS_OUTPUT_DIR=./data/audio
TTS_TIMEOUT_SECONDS=60

# ---- Payments (one-time only) ----
PAYMENT_PROVIDER=mock               # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_PAYMENT_WEBHOOK_SECRET=change-me
PAYMENT_CURRENCY=usd
PUBLIC_BASE_URL=http://localhost:8000

# ---- Delivery handoff ----
DELIVERY_TARGET=file                # file | http
DELIVERY_OUTBOX_DIR=./data/delivery
ORCHESTRATOR_URL=
ORCHESTRATOR_TOKEN=
